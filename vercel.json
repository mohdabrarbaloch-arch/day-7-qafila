{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": "app/static/**"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/app/main.py" }]
}
