# Qafila — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=Qafila — Logistics AI Agent Platform
ENVIRONMENT=development
API_PREFIX=/api

# --- Security (REQUIRED: change in production) ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# --- Database ---
# SQLite (default): sqlite:///./qafila.db
# PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/qafila
DATABASE_URL=sqlite:///./qafila.db

# --- CORS ---
# Comma-separated origins, or * for all
CORS_ORIGINS=*

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Seed ---
SEED_DEMO_DATA=true
