# Qafila configuration. Every value below has a working default for local
# development — copy this file to .env and change what you need.

# development | production
# In production the app refuses to start if JWT_SECRET is still the dev default.
ENVIRONMENT=development

# SQLite by default so the project runs with zero setup.
# Postgres: postgresql+psycopg://qafila:qafila@localhost:5432/qafila
DATABASE_URL=sqlite:///./qafila.db

# Signing key for JWTs. Generate a real one with: openssl rand -hex 32
# Never commit the real value.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256

# Access token lifetime in minutes. 1440 = 24 hours.
ACCESS_TOKEN_MINUTES=1440

# Comma-separated origins, or * for any. Set an explicit list in production.
CORS_ORIGINS=*

# Requests per minute per client IP, per process.
# Note: this counter is in-process, so N workers allow N times this rate.
RATE_LIMIT_PER_MINUTE=240

# Seed four agents, four shipments and a demo admin on startup.
# Set to false for a clean database.
SEED_DEMO_DATA=true

# Demo account. Leave DEMO_PASSWORD empty to skip creating it entirely —
# a deployed instance should never ship with a known login.
DEMO_EMAIL=operator@qafila.pk
DEMO_PASSWORD=
